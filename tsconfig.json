{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "es2022",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "target/dist",
    "esModuleInterop": true,
    "noEmit": false
  },
  "include": ["src/**/*"]
}
